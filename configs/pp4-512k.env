# Morrowmake recipe 1.6.0 — PP4 production profile (long-context / throughput)
# Launch: RUNTIME=native LAYOUT=pp4 ./start.sh
# (or plain ./start.sh with this .env; the launcher sets layer split 13,11,11,10,
#  PP runtime settings, block size and allocator automatically)
SPEC_MODE=dflash
MAX_LEN=524288
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
# API key: set your own; do not commit real keys
# API_KEY=<your-key>
