# Morrowmake recipe 1.6.0 — TP4 profile (single-stream interactive)
# Launch: RUNTIME=native LAYOUT=tp4 ./start.sh
# Needs all four slots on x16 for the published community numbers;
# on x4 links single-stream still wins vs PP4 but aggregate degrades.
SPEC_MODE=dflash
MAX_LEN=262144
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
# API key: set your own; do not commit real keys
# API_KEY=<your-key>
